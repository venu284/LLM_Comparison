# ===========================================
# Database - Neon Serverless Postgres (free)
# ===========================================
# 1. Sign up at https://neon.tech (no credit card)
# 2. Create project and copy the connection string
# 3. Paste below:
DATABASE_URL=postgresql://user:pass@ep-cool-night-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ===========================================
# OpenRouter API Key (single key for all 5 models)
# ===========================================
# 1. Sign up at https://openrouter.ai
# 2. Go to https://openrouter.ai/settings/keys
# 3. Create key and paste below:
OPENROUTER_API_KEY=sk-or-v1-...

# ===========================================
# Settings
# ===========================================
MAX_TOKENS=4096
TEMPERATURE=0.2
WARMUP_REQUESTS=3
RUNS_PER_TASK=3
