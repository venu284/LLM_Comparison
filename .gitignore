# Claude Code local state (worktrees, handovers). Durable notes live in docs/history/.
.claude/

# OS
.DS_Store

# Python
__pycache__/
*.py[cod]
.pytest_cache/
# No trailing slash, so a worktree's symlink to the main checkout's venv is ignored too
venv
.venv

# Secrets: every .env variant except the template
.env*
!.env.example

# Node
node_modules/

# Third-party code and data cloned for the router (see docs/IMPLEMENTATION_PLAN.md, M1.1)
# Not `external/`: a trailing-slash rule cannot be negated for files inside it.
# CHECKSUMS is the one committed file (pinned hashes, see scripts/fetch_data.py).
external/*
!external/CHECKSUMS

# Local router state (model registry, caches)
*.sqlite

# Reports are kept locally, not versioned
Reports/
